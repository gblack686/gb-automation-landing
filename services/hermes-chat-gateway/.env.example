# hermes-chat-gateway — example env. Copy to .env (gitignored) and fill in.
# NOTHING here is committed with a real value. Secrets live only in the runtime
# environment (e.g. systemd EnvironmentFile, op run, or AWS SM injection).

# --- Listener -----------------------------------------------------------------
PORT=3050

# --- Cognito verification (us-east-1_9C7FJkK9b) -------------------------------
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_9C7FJkK9b
COGNITO_REQUIRED_GROUP=tenant-smoke-client
# Optional: pin the app client id when verifying ID tokens (audience check).
# COGNITO_CLIENT_ID=
# Optional override; derived from the pool when unset.
# COGNITO_JWKS_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_9C7FJkK9b/.well-known/jwks.json

# --- Upstream Hermes (NEVER exposed to the browser) ---------------------------
# Public-internal endpoint of the Hermes chat surface for the smoke-client tenant.
HERMES_SMOKE_ENDPOINT=
# Server-held bearer token for the upstream session. SECRET — env only.
HERMES_SMOKE_TOKEN=
# How to inject it upstream: 'authorization' (default, sent as Bearer) or a
# custom header name (token sent verbatim).
HERMES_TOKEN_HEADER=authorization
