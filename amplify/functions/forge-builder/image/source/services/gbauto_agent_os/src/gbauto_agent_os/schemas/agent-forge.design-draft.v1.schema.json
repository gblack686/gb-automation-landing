{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbautomation.xyz/schemas/agent-forge.design-draft.v1.schema.json",
  "title": "Proposed Agent Forge shared prospect draft response",
  "description": "Planning specification. Server response only; never accept this object as an answer command.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "agent-forge.design-draft.v1"
    },
    "draft_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "owner_subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "namespace": {
      "const": "prospect"
    },
    "draft_version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "stage": {
      "enum": [
        "collecting",
        "queued",
        "generating",
        "needs_answers",
        "design_ready",
        "email_pending",
        "delivered",
        "needs_review",
        "expired",
        "cancelled"
      ]
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "website": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "website",
        "summary"
      ]
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "revisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revision"
      },
      "minItems": 1,
      "maxItems": 30
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "$ref": "#/$defs/coverage"
        },
        "audience": {
          "$ref": "#/$defs/coverage"
        },
        "data_access": {
          "$ref": "#/$defs/coverage"
        },
        "output": {
          "$ref": "#/$defs/coverage"
        },
        "success": {
          "$ref": "#/$defs/coverage"
        },
        "boundaries": {
          "$ref": "#/$defs/coverage"
        }
      },
      "required": [
        "purpose",
        "audience",
        "data_access",
        "output",
        "success",
        "boundaries"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "submitted_batches": {
          "const": 3
        },
        "followup_questions": {
          "const": 4
        },
        "model_attempts": {
          "const": 4
        },
        "shared_retries": {
          "const": 1
        },
        "aggregate_billed_tokens": {
          "const": 30000
        },
        "inference_micro_usd": {
          "const": 50000
        }
      },
      "required": [
        "submitted_batches",
        "followup_questions",
        "model_attempts",
        "shared_retries",
        "aggregate_billed_tokens",
        "inference_micro_usd"
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "submitted_batches": {
          "type": "integer",
          "minimum": 0
        },
        "model_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "shared_retries": {
          "type": "integer",
          "minimum": 0
        },
        "billed_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reserved_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "charged_micro_usd": {
          "type": "integer",
          "minimum": 0
        },
        "reserved_micro_usd": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "submitted_batches",
        "model_attempts",
        "shared_retries",
        "billed_tokens",
        "reserved_tokens",
        "charged_micro_usd",
        "reserved_micro_usd"
      ]
    },
    "issued_question_set": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "question_set_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "questions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/question"
              },
              "minItems": 1,
              "maxItems": 4
            }
          },
          "required": [
            "question_set_id",
            "version",
            "questions"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "enum": [
              "customer_answer",
              "public_web",
              "platform_template"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "evidence_id",
          "kind",
          "source_ref",
          "captured_at",
          "excerpt"
        ]
      },
      "minItems": 0,
      "maxItems": 30
    },
    "design": {
      "oneOf": [
        {
          "$ref": "#/$defs/design"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact": {
      "oneOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "design_status": {
          "enum": [
            "incomplete",
            "ready",
            "needs_review"
          ]
        },
        "runtime_status": {
          "const": "not_authorized"
        },
        "missing_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 30
        }
      },
      "required": [
        "design_status",
        "runtime_status",
        "missing_requirements"
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "not_requested",
            "pending",
            "accepted",
            "delivered",
            "bounced",
            "complained",
            "failed"
          ]
        },
        "artifact_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        }
      },
      "required": [
        "state",
        "artifact_id"
      ]
    }
  },
  "required": [
    "schema_version",
    "draft_id",
    "owner_subject",
    "namespace",
    "draft_version",
    "created_at",
    "expires_at",
    "stage",
    "business",
    "catalog_version",
    "revisions",
    "coverage",
    "limits",
    "usage",
    "issued_question_set",
    "evidence",
    "design",
    "artifact",
    "readiness",
    "delivery"
  ],
  "$defs": {
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "answer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "question_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 250
              },
              "minItems": 0,
              "maxItems": 20
            }
          ]
        },
        "provenance": {
          "enum": [
            "customer_assertion",
            "customer_confirmed_default",
            "operator_assertion"
          ]
        }
      },
      "required": [
        "answer_id",
        "question_id",
        "value",
        "provenance"
      ]
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "parent_revision_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "question_set_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "answers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/answer"
          },
          "minItems": 1,
          "maxItems": 10
        }
      },
      "required": [
        "revision_id",
        "parent_revision_id",
        "question_set_version",
        "created_at",
        "answers"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "answered",
            "confirmed_default",
            "unknown",
            "deferred_to_onboarding"
          ]
        },
        "value": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 250
                  },
                  "minItems": 0,
                  "maxItems": 20
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "answer_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 0,
          "maxItems": 30
        },
        "note": {
          "type": "string",
          "maxLength": 1500
        }
      },
      "required": [
        "status",
        "value",
        "answer_ids",
        "note"
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "minItems": 0,
          "maxItems": 8
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "minItems": 1,
          "maxItems": 8
        },
        "proposed_skill_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 0,
          "maxItems": 8
        },
        "proposed_permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "minItems": 0,
          "maxItems": 8
        },
        "onboarding_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 12
        }
      },
      "required": [
        "agent_id",
        "role",
        "purpose",
        "inputs",
        "outputs",
        "proposed_skill_refs",
        "proposed_permissions",
        "onboarding_gaps"
      ]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "agent_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 1,
          "maxItems": 4
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "minItems": 1,
          "maxItems": 8
        },
        "human_approval_points": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 8
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 1,
          "maxItems": 6
        }
      },
      "required": [
        "workflow_id",
        "title",
        "agent_ids",
        "steps",
        "human_approval_points",
        "success_criteria"
      ]
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent"
          },
          "minItems": 2,
          "maxItems": 4
        },
        "workflows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workflow"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "priority_workflow_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 15
        },
        "unresolved_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 15
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 0,
          "maxItems": 30
        }
      },
      "required": [
        "title",
        "summary",
        "agents",
        "workflows",
        "priority_workflow_id",
        "assumptions",
        "unresolved_gaps",
        "evidence_refs"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "catalog_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "input_type": {
          "enum": [
            "text",
            "single_select",
            "multi_select",
            "boolean"
          ]
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "minItems": 0,
          "maxItems": 10
        },
        "allow_unknown": {
          "const": true
        }
      },
      "required": [
        "question_id",
        "catalog_ref",
        "label",
        "reason",
        "input_type",
        "choices",
        "allow_unknown"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "design_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "generator_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "result_path": {
          "type": "string",
          "pattern": "^/forge/designs/[a-zA-Z0-9_-]+$"
        }
      },
      "required": [
        "artifact_id",
        "content_sha256",
        "design_version",
        "prompt_version",
        "schema_version",
        "generator_model",
        "result_path"
      ]
    }
  }
}
