{
  "$defs": {
    "AtlasItem": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/AtlasReference"
        },
        "title": {
          "maxLength": 240,
          "title": "Title",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "harness": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harness"
        },
        "profile": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "stable_host_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stable Host Id"
        },
        "native_session_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Session Id"
        },
        "parent_session_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Session Id"
        },
        "event_at": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event At"
        },
        "ingested_at": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ingested At"
        },
        "owner": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "runtime_profiles": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Runtime Profiles",
          "type": "array"
        },
        "related": {
          "items": {
            "$ref": "#/$defs/AtlasReference"
          },
          "maxItems": 30,
          "title": "Related",
          "type": "array"
        },
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 16000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "preview": {
          "default": "reference_card",
          "enum": [
            "reference_card",
            "missing",
            "retired"
          ],
          "title": "Preview",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "title"
      ],
      "title": "AtlasItem",
      "type": "object"
    },
    "AtlasQuery": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "gbauto.atlas-query.v1",
          "default": "gbauto.atlas-query.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "default": "experts",
          "enum": [
            "experts",
            "capabilities",
            "sessions",
            "artifacts",
            "delivery",
            "analytics",
            "pull_requests"
          ],
          "title": "Kind",
          "type": "string"
        },
        "repo": {
          "const": "gbautomation",
          "default": "gbautomation",
          "title": "Repo",
          "type": "string"
        },
        "client": {
          "const": "gbautomation",
          "default": "gbautomation",
          "title": "Client",
          "type": "string"
        },
        "expert": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expert"
        },
        "harness": {
          "anyOf": [
            {
              "enum": [
                "hermes",
                "codex",
                "claude-code"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harness"
        },
        "profile": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "stable_host_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stable Host Id"
        },
        "session_key": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Key"
        },
        "native_session_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Session Id"
        },
        "id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "version_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Id"
        },
        "hours": {
          "default": 0,
          "enum": [
            0,
            24,
            168,
            720
          ],
          "title": "Hours",
          "type": "integer"
        },
        "limit": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        }
      },
      "title": "AtlasQuery",
      "type": "object"
    },
    "AtlasReference": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "gbauto.atlas-reference.v1",
          "default": "gbauto.atlas-reference.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "experts",
            "capabilities",
            "sessions",
            "artifacts",
            "delivery",
            "analytics",
            "pull_requests"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Id",
          "type": "string"
        },
        "version_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "bundle_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bundle Id"
        },
        "session_key": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Key"
        },
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "AtlasReference",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "unit": {
          "enum": [
            "hours",
            "count",
            "ratio"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "missing_count": {
          "minimum": 0,
          "title": "Missing Count",
          "type": "integer"
        },
        "eligible_count": {
          "minimum": 0,
          "title": "Eligible Count",
          "type": "integer"
        },
        "completeness": {
          "default": "explicit_links_only",
          "enum": [
            "explicit_links_only",
            "unknown"
          ],
          "title": "Completeness",
          "type": "string"
        }
      },
      "required": [
        "id",
        "definition",
        "unit",
        "sample_count",
        "missing_count",
        "eligible_count"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "repo": {
          "const": "gbautomation",
          "default": "gbautomation",
          "title": "Repo",
          "type": "string"
        },
        "client": {
          "const": "gbautomation",
          "default": "gbautomation",
          "title": "Client",
          "type": "string"
        }
      },
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "gbauto.atlas-result.v1",
      "default": "gbauto.atlas-result.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "query": {
      "$ref": "#/$defs/AtlasQuery"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "stale",
        "unavailable",
        "offline"
      ],
      "title": "Status",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/AtlasItem"
      },
      "maxItems": 100,
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "observed_at": {
      "title": "Observed At",
      "type": "string"
    },
    "source_event_max": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Event Max"
    },
    "ingested_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ingested At"
    },
    "checkpoint_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint Ref"
    },
    "completeness": {
      "default": "unknown",
      "enum": [
        "bounded_page",
        "partial",
        "unknown"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Warnings",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "maxItems": 10,
      "title": "Metrics",
      "type": "array"
    }
  },
  "required": [
    "query",
    "status",
    "observed_at"
  ],
  "title": "AtlasResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbautomation.xyz/schemas/gbauto.atlas-result.v1.schema.json"
}
