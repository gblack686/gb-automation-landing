{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gbautomation.xyz/schemas/tac-routing-decision-receipt.v1.json",
  "title": "TAC routing decision receipt v1",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "task_id",
    "request_sha256",
    "workflow_template_id",
    "current_step_key",
    "selected_node_id",
    "decision",
    "model",
    "retrieval_bundle",
    "validation",
    "artifact",
    "dashboard_projection"
  ],
  "properties": {
    "schema_version": {
      "const": "tac-routing-decision-receipt.v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^trd_[0-9a-f]{24}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 2
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workflow_template_id": {
      "type": "string",
      "minLength": 1
    },
    "current_step_key": {
      "type": "string",
      "minLength": 1
    },
    "selected_node_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "object",
      "required": [
        "mode",
        "confidence",
        "matched_rules",
        "ambiguous",
        "fallback_used",
        "reason",
        "classifier"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "matched_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ambiguous": {
          "type": "boolean"
        },
        "fallback_used": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "classifier": {
          "type": "object",
          "required": [
            "used",
            "invocation_count",
            "max_invocations",
            "candidate_count",
            "non_executing"
          ],
          "properties": {
            "used": {
              "type": "boolean"
            },
            "invocation_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "max_invocations": {
              "const": 1
            },
            "candidate_count": {
              "type": "integer",
              "minimum": 0
            },
            "non_executing": {
              "const": true
            },
            "selected_workflow_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "policy_ref",
        "selection",
        "requested_tier",
        "enforcement",
        "deferred_metadata"
      ],
      "properties": {
        "policy_ref": {
          "type": "string"
        },
        "selection": {
          "type": "string"
        },
        "requested_tier": {
          "type": "object"
        },
        "enforcement": {
          "type": "object",
          "required": [
            "state",
            "reason",
            "enforced_fields",
            "deferred_fields"
          ],
          "properties": {
            "state": {
              "enum": [
                "enforced",
                "model_enforced_effort_deferred",
                "deferred",
                "not_requested"
              ]
            },
            "reason": {
              "type": "string"
            },
            "model_override": {
              "type": [
                "string",
                "null"
              ]
            },
            "mapping_env": {
              "type": [
                "string",
                "null"
              ]
            },
            "enforced_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deferred_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "deferred_metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "retrieval_bundle": {
      "type": "object",
      "required": [
        "reference_schema_version",
        "schema_version",
        "artifact_id",
        "sha256"
      ],
      "properties": {
        "reference_schema_version": {
          "const": "tac-retrieval-bundle-reference.v1"
        },
        "schema_version": {
          "const": "tac-retrieval-bundle.v1"
        },
        "artifact_id": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo_relative_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "gate_id",
        "gate_count"
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "event_kind"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "event_kind": {
          "const": "routing_decision"
        }
      },
      "additionalProperties": false
    },
    "dashboard_projection": {
      "type": "object",
      "required": [
        "schema_version",
        "task_id",
        "workflow_template_id",
        "current_step_key",
        "route_id",
        "selected_node_id",
        "resolution_mode",
        "ambiguous",
        "classifier_used",
        "classifier_invocation_count",
        "model_enforcement_state",
        "validation_gate_id",
        "routing_receipt_id",
        "routing_receipt_path"
      ],
      "properties": {
        "schema_version": {
          "const": "tac-routing-dashboard-projection.v1"
        },
        "classifier_invocation_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
