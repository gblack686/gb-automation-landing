{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbautomation.xyz/schemas/agent-forge-research-dossier.v1.schema.json",
  "title": "Agent Forge cited research dossier v1",
  "type": "object",
  "required": ["schema_version", "dossier_id", "planning_run_id", "source_event_id", "tenant", "required_lanes", "lane_receipts", "claims", "evidence_refs", "contradictions", "gap_matrix", "alternatives", "risks", "rollout", "rollback", "unresolved_findings", "status", "dossier_sha256", "created_at"],
  "properties": {
    "schema_version": {"const": "agent-forge.research-dossier.v1"},
    "dossier_id": {"type": "string", "pattern": "^forge_dossier_[a-z0-9_]+$", "maxLength": 128},
    "planning_run_id": {"type": "string", "pattern": "^forge_plan_run_[a-z0-9_]+$", "maxLength": 128},
    "source_event_id": {"type": "string", "pattern": "^src_agent_forge_planning_[a-z0-9_]+$", "maxLength": 128},
    "tenant": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "required_lanes": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["repository", "tac_profile", "provider_runtime", "privacy_rights"]}},
    "lane_receipts": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["lane_id", "status", "source_count", "fetched_bytes", "elapsed_ms", "token_count", "measured_cost_usd", "retries", "budget", "evidence_ids", "findings"],
        "properties": {
          "lane_id": {"enum": ["repository", "tac_profile", "provider_runtime", "privacy_rights"]},
          "status": {"enum": ["completed", "partial", "failed"]},
          "source_count": {"type": "integer", "minimum": 0, "maximum": 50},
          "fetched_bytes": {"type": "integer", "minimum": 0, "maximum": 5000000},
          "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 3600000},
          "token_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
          "measured_cost_usd": {"type": "number", "minimum": 0, "maximum": 1000},
          "retries": {"type": "integer", "minimum": 0, "maximum": 3},
          "budget": {
            "type": "object", "additionalProperties": false,
            "required": ["max_sources", "max_bytes", "max_wall_seconds", "max_tokens", "max_cost_usd"],
            "properties": {
              "max_sources": {"type": "integer", "minimum": 1, "maximum": 50},
              "max_bytes": {"type": "integer", "minimum": 1, "maximum": 5000000},
              "max_wall_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
              "max_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
              "max_cost_usd": {"type": "number", "minimum": 0, "maximum": 1000}
            }
          },
          "evidence_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence_[a-z0-9_]+$"}},
          "findings": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
        }
      }
    },
    "claims": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim_id", "statement", "evidence_ids", "confidence"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^claim_[a-z0-9_]+$"},
          "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
          "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence_[a-z0-9_]+$"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "evidence_refs": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "lane_id", "source_type", "source_ref", "fetched_at", "content_sha256", "rights_class", "confidence", "supported_claim_ids"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^evidence_[a-z0-9_]+$"},
          "lane_id": {"enum": ["repository", "tac_profile", "provider_runtime", "privacy_rights"]},
          "source_type": {"enum": ["repository", "tac_catalog", "official_documentation", "runtime_readback", "operator_approved_fixture"]},
          "source_ref": {"type": "string", "minLength": 1, "maxLength": 1000},
          "fetched_at": {"type": "string", "format": "date-time"},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "rights_class": {"enum": ["repository_internal", "public_reference", "operator_approved_fixture"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "supported_claim_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^claim_[a-z0-9_]+$"}}
        }
      }
    },
    "contradictions": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "gap_matrix": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "alternatives": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "risks": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "rollout": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "rollback": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "unresolved_findings": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "status": {"enum": ["complete", "partial", "failed_with_receipt"]},
    "dossier_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
