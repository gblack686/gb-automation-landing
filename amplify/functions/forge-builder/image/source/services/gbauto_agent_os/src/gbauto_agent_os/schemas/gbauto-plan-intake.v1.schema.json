{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gbautomation.xyz/schemas/gbauto-plan-intake.v1.schema.json",
  "title": "GBAutomation durable plan intake receipt v1",
  "type": "object",
  "required": [
    "schema_version",
    "intake_id",
    "version",
    "created_at",
    "updated_at",
    "status",
    "request",
    "primed_sources",
    "questions",
    "assumptions",
    "provisional_diagrams",
    "operator_decision",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": "gbauto-plan-intake.v1"
    },
    "intake_id": {
      "type": "string",
      "pattern": "^plan-intake-[a-z0-9][a-z0-9-]{2,119}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    },
    "updated_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    },
    "status": {
      "enum": [
        "draft",
        "scope_changes_requested",
        "scope_approved",
        "implementation_changes_requested",
        "implementation_approved",
        "rejected"
      ]
    },
    "request": {
      "type": "object",
      "required": [
        "source",
        "privacy",
        "summary",
        "repository",
        "base_commit",
        "branch"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "privacy": {
          "enum": [
            "repository_internal",
            "public"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "additionalProperties": false
    },
    "primed_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "not": {
              "pattern": "^(?:[A-Za-z]:[\\\\/]|/)"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "answer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,79}$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "provisional_diagrams": {
      "type": "object",
      "required": [
        "canonical",
        "transition",
        "target_architecture"
      ],
      "properties": {
        "canonical": {
          "const": false
        },
        "transition": {
          "$ref": "#/definitions/diagram"
        },
        "target_architecture": {
          "$ref": "#/definitions/diagram"
        }
      },
      "additionalProperties": false
    },
    "operator_decision": {
      "type": "object",
      "required": [
        "decision",
        "decided_at",
        "source",
        "note",
        "scope_approval",
        "planning_authorized",
        "implementation_authorized",
        "runtime_activation_authorized",
        "implementation_decision"
      ],
      "properties": {
        "decision": {
          "enum": [
            "pending",
            "approved",
            "changes_requested",
            "rejected"
          ]
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "note": {
          "type": "string",
          "maxLength": 4000
        },
        "scope_approval": {
          "type": "boolean"
        },
        "planning_authorized": {
          "type": "boolean"
        },
        "implementation_authorized": {
          "type": "boolean"
        },
        "runtime_activation_authorized": {
          "type": "boolean"
        },
        "implementation_decision": {
          "$ref": "#/definitions/implementationDecision"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "plan_path",
        "architecture_path",
        "implementation_gate"
      ],
      "properties": {
        "plan_path": {
          "$ref": "#/definitions/repositoryPath"
        },
        "architecture_path": {
          "$ref": "#/definitions/repositoryPath"
        },
        "implementation_gate": {
          "enum": [
            "pending",
            "changes_requested",
            "approved",
            "rejected"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "allOf": [
        {
          "not": {
            "pattern": "^(?:[A-Za-z]:[\\\\/]|/)"
          }
        },
        {
          "not": {
            "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
          }
        }
      ]
    },
    "diagram": {
      "type": "object",
      "required": [
        "title",
        "mermaid"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mermaid": {
          "type": "string",
          "minLength": 20,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    },
    "implementationDecision": {
      "type": "object",
      "required": [
        "decision",
        "decided_at",
        "source",
        "note",
        "authorized_phases",
        "excluded_actions",
        "plan_sha256",
        "architecture_sha256",
        "base_commit"
      ],
      "properties": {
        "decision": {
          "enum": [
            "pending",
            "approved",
            "changes_requested",
            "rejected"
          ]
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "note": {
          "type": "string",
          "maxLength": 4000
        },
        "authorized_phases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          }
        },
        "excluded_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "plan_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "architecture_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "base_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
