{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gbautomation.xyz/schemas/atlas-projection.v1.schema.json",
  "title": "Expert Atlas agent-os hash-readback projection v1",
  "type": "object",
  "required": [
    "schema_version",
    "route",
    "identifier",
    "version",
    "plan_path",
    "plan_sha256",
    "architecture_path",
    "architecture_payload_sha256",
    "architecture_file_sha256",
    "source_commit",
    "generated_at",
    "freshness_seconds",
    "gate_status",
    "publication_route",
    "readback_result",
    "mismatch_reason"
  ],
  "properties": {
    "schema_version": {
      "const": "atlas-projection.v1"
    },
    "route": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^/"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,119}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "plan_path": {
      "$ref": "#/definitions/repositoryPath"
    },
    "plan_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "architecture_path": {
      "$ref": "#/definitions/repositoryPath"
    },
    "architecture_payload_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "architecture_file_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "freshness_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31536000
    },
    "gate_status": {
      "enum": [
        "pending",
        "implementation_approved",
        "mismatch"
      ]
    },
    "publication_route": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^/"
    },
    "readback_result": {
      "enum": [
        "not_run",
        "match",
        "mismatch"
      ]
    },
    "mismatch_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "definitions": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "allOf": [
        {
          "not": {
            "pattern": "^(?:[A-Za-z]:[\\\\/]|/)"
          }
        },
        {
          "not": {
            "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
          }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
