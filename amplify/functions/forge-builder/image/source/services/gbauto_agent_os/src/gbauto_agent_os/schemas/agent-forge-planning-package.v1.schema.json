{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbautomation.xyz/schemas/agent-forge-planning-package.v1.schema.json",
  "title": "Agent Forge hash-bound planning package v1",
  "type": "object",
  "required": ["schema_version", "planning_package_id", "planning_run_id", "bundle_sha256", "research_decision_ref", "dossier_sha256", "proposal_id", "proposal_sha256", "validation_sha256", "prd_id", "prd_sha256", "plan_path", "plan_sha256", "architecture_version_id", "architecture_sha256", "architecture_status", "profile_id", "profile_hash", "repository_map_id", "repository_map_hash", "implementation_decision_ref", "authority", "package_sha256", "created_at"],
  "properties": {
    "schema_version": {"const": "agent-forge.planning-package.v1"},
    "planning_package_id": {"type": "string", "pattern": "^forge_planning_package_[a-z0-9_]+$", "maxLength": 128},
    "planning_run_id": {"type": "string", "pattern": "^forge_plan_run_[a-z0-9_]+$", "maxLength": 128},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "research_decision_ref": {"type": "string", "minLength": 1, "maxLength": 500},
    "dossier_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposal_id": {"type": "string", "pattern": "^prop_[a-z0-9_]+$", "maxLength": 128},
    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prd_id": {"type": "string", "pattern": "^prd_[a-z0-9_]+$", "maxLength": 128},
    "prd_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_path": {"type": "string", "pattern": "^second-brain/plans/.+\\.html$", "maxLength": 1000},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "architecture_version_id": {"type": "string", "minLength": 3, "maxLength": 200},
    "architecture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "architecture_status": {"enum": ["approved", "implemented"]},
    "profile_id": {"type": "string", "pattern": "^profile\\.[a-z0-9.-]+$"},
    "profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_map_id": {"type": "string", "pattern": "^map\\.[a-z0-9.-]+$"},
    "repository_map_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation_decision_ref": {"type": "string", "minLength": 1, "maxLength": 500},
    "authority": {"const": "planning_only"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
