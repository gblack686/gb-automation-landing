{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbautomation.local/schemas/tac-adw-pilot-fixtures.v1.schema.json",
  "title": "TAC ADW Pilot Fixtures v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "phase_a_source",
    "production_execution_allowed",
    "retrieval_bundles",
    "pilots",
    "ambiguity_examples"
  ],
  "properties": {
    "schema_version": {
      "const": "tac-adw-pilot-fixtures.v1"
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "phase_a_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merge_sha",
        "retrieval_bundle_schema",
        "artifact_paths"
      ],
      "properties": {
        "merge_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "retrieval_bundle_schema": {
          "const": "tac-retrieval-bundle.v1"
        },
        "artifact_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "production_execution_allowed": {
      "const": false
    },
    "retrieval_bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/retrievalBundle"
      }
    },
    "pilots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pilot"
      }
    },
    "ambiguity_examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ambiguityExample"
      }
    }
  },
  "$defs": {
    "retrievalBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_kind",
        "bundle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "source_kind": {
          "const": "sanitized_phase_a_fixture"
        },
        "bundle": {
          "type": "object"
        }
      }
    },
    "expectedRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_template_id",
        "route",
        "resolution_mode",
        "ambiguous",
        "classifier_invocation_count",
        "selected_node_keys"
      ],
      "properties": {
        "workflow_template_id": {
          "type": "string"
        },
        "route": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "resolution_mode": {
          "enum": [
            "deterministic",
            "classifier",
            "fallback"
          ]
        },
        "ambiguous": {
          "type": "boolean"
        },
        "classifier_invocation_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "selected_node_keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "pilot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "request",
        "retrieval_bundle_ref",
        "execution_mode",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^pilot-[a-z0-9-]+$"
        },
        "request": {
          "type": "string",
          "minLength": 1
        },
        "retrieval_bundle_ref": {
          "type": "string"
        },
        "execution_mode": {
          "const": "dry_run"
        },
        "expected": {
          "$ref": "#/$defs/expectedRoute"
        }
      }
    },
    "ambiguityExample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "request",
        "retrieval_bundle_ref",
        "execution_mode",
        "classifier_max_invocations",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ambiguity-[a-z0-9-]+$"
        },
        "request": {
          "type": "string",
          "minLength": 1
        },
        "retrieval_bundle_ref": {
          "type": "string"
        },
        "execution_mode": {
          "const": "dry_run"
        },
        "classifier_max_invocations": {
          "const": 1
        },
        "classifier_response": {
          "type": [
            "object",
            "null"
          ]
        },
        "expected": {
          "$ref": "#/$defs/expectedRoute"
        }
      }
    }
  }
}
