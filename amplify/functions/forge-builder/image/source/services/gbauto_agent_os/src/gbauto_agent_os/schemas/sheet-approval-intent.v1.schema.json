{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbautomation.xyz/schemas/sheet-approval-intent.v1.json",
  "title": "Sheet Approval Intent",
  "type": "object",
  "required": [
    "schema_version",
    "channel_version",
    "registry_id",
    "tenant_id",
    "workbook_id",
    "sheet_id",
    "row_id",
    "prd_id",
    "row_version",
    "gate_id",
    "run_id",
    "parent_task_id",
    "gate_version",
    "decision",
    "actor_email",
    "actor_domain",
    "artifact_sha256",
    "context_packet_sha256",
    "source_commit",
    "allowed_resume_targets",
    "resume_targets_sha256",
    "nonce",
    "issued_at",
    "idempotency_key",
    "adapter_key_id"
  ],
  "properties": {
    "schema_version": {"const": "sheet-approval-intent.v1"},
    "channel_version": {"const": "human-approval-channel.v2"},
    "registry_id": {"type": "string", "pattern": "^msr_[a-z0-9_]{4,80}$"},
    "tenant_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "workbook_id": {"type": "string", "minLength": 20, "maxLength": 240},
    "sheet_id": {"type": "integer", "minimum": 0},
    "row_id": {"type": "string", "pattern": "^msr_[0-9a-f]{16,64}$"},
    "prd_id": {"type": "string", "minLength": 12, "maxLength": 180},
    "row_version": {"type": "integer", "minimum": 1},
    "gate_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,180}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,180}$"},
    "parent_task_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,180}$"},
    "gate_version": {"type": "integer", "minimum": 1},
    "decision": {"enum": ["approve", "request_changes", "snooze", "reject"]},
    "actor_email": {"type": "string", "format": "email", "maxLength": 320},
    "actor_domain": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "context_packet_sha256": {"$ref": "#/$defs/sha256"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "allowed_resume_targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,180}$"}
    },
    "resume_targets_sha256": {"$ref": "#/$defs/sha256"},
    "nonce": {"type": "string", "format": "uuid"},
    "issued_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"$ref": "#/$defs/sha256"},
    "adapter_key_id": {"type": "string", "pattern": "^msa_[a-z0-9_]{4,80}$"},
    "note": {"type": ["string", "null"], "maxLength": 8000},
    "snooze_until": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "snooze"}}, "required": ["decision"]},
      "then": {"required": ["snooze_until"], "properties": {"snooze_until": {"type": "string", "format": "date-time"}}},
      "else": {"properties": {"snooze_until": {"type": "null"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
