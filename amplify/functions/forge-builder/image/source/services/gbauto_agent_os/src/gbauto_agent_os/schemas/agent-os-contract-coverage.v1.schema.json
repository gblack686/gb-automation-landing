{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gbautomation.xyz/schemas/agent-os-contract-coverage.v1.schema.json",
  "title": "Agent OS live contract coverage v1",
  "description": "Public-safe snapshot of the protected Supabase contract coverage view. Contains aggregate counts and timestamps only, never payloads, repository paths, credentials, or source references.",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_source",
    "generated_at",
    "project_ref",
    "coverage_view",
    "summary",
    "contracts"
  ],
  "properties": {
    "schema_version": {"const": "agent-os-contract-coverage.v1"},
    "snapshot_source": {"enum": ["git_fallback", "live_supabase"]},
    "generated_at": {"$ref": "#/definitions/timestamp"},
    "project_ref": {"type": "string", "pattern": "^[a-z]{20}$"},
    "coverage_view": {"const": "public.v_agent_os_data_contract_coverage"},
    "summary": {
      "type": "object",
      "required": [
        "contract_count",
        "native_mapping_count",
        "shared_mapping_count",
        "contracts_with_records",
        "contracts_without_records",
        "persistence_record_count"
      ],
      "properties": {
        "contract_count": {"type": "integer", "minimum": 0},
        "native_mapping_count": {"type": "integer", "minimum": 0},
        "shared_mapping_count": {"type": "integer", "minimum": 0},
        "contracts_with_records": {"type": "integer", "minimum": 0},
        "contracts_without_records": {"type": "integer", "minimum": 0},
        "persistence_record_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "contract_id",
          "mapping_mode",
          "supabase_schema",
          "supabase_relation",
          "relation_kind",
          "sample_count",
          "has_samples",
          "shared_record_count",
          "persistence_record_count",
          "coverage_state",
          "latest_recorded_at",
          "registry_version"
        ],
        "properties": {
          "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*\\.v[0-9]+$"},
          "mapping_mode": {"enum": ["native_table", "shared_envelope"]},
          "supabase_schema": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"},
          "supabase_relation": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"},
          "relation_kind": {"const": "table"},
          "sample_count": {"type": "integer", "minimum": 0},
          "has_samples": {"type": "boolean"},
          "shared_record_count": {"type": "integer", "minimum": 0},
          "persistence_record_count": {"type": "integer", "minimum": 0},
          "coverage_state": {"enum": ["live_records", "registered_only"]},
          "latest_recorded_at": {
            "anyOf": [{"$ref": "#/definitions/timestamp"}, {"type": "null"}]
          },
          "registry_version": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  },
  "additionalProperties": false
}
