{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "agent_id",
    "board_slug",
    "config_sha256",
    "captured_at",
    "source",
    "prds",
    "cards",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "forge-planning-snapshot.v1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "board_slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "enum": [
        "supabase",
        "prd-index"
      ]
    },
    "prds": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prd_id",
          "title",
          "status",
          "path",
          "updated_at",
          "config_sha256",
          "source",
          "body_sha256"
        ],
        "properties": {
          "prd_id": {
            "type": "string",
            "pattern": "^prd_[a-f0-9]{20}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?!/)(?!.*\\.\\.)(?!.*[\\\\:])[a-zA-Z0-9_./ -]+$"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "config_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "const": "prd_artifacts"
          },
          "body_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "title",
          "status",
          "updated_at",
          "prd_ids"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "prd_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^prd_[a-f0-9]{20}$"
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "filename",
          "title",
          "mime",
          "bytes",
          "sha256",
          "kind",
          "prd_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
          },
          "filename": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,119}\\.(html|yaml|json|md|txt)$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "mime": {
            "enum": [
              "text/html",
              "application/yaml",
              "application/json",
              "text/markdown",
              "text/plain"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "example",
              "actual"
            ]
          },
          "prd_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^prd_[a-f0-9]{20}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
