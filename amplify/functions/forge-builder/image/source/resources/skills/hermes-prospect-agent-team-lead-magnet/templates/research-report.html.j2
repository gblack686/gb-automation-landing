<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex, nofollow" />
<title>Research: {{company_name}} — internal report</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" />
<style>
  /* TAC-plan output format (official-gbauto-tac-plan-template.html shell:
     topbar / taxonomy pills / section menu / metadata footer / header visual),
     re-skinned onto the client-report neon tokens so the research report
     inherits the proposal page's CSS and colors. Operator-directed 2026-07-13:
     single continuous flow (no collapsible sections), TOC via the section
     menu, meta pills + metadata footer, SVG top-right (header visual). */
  :root{
    --terracotta:#D97757;--terracotta-hover:#B75F43;--cyan:#67E8F9;
    --void:#0A0608;--void2:#0A0A0C;--panel:#111112;--panel2:#18181B;--edge:#1F1F22;
    --cream:#F3F1E7;--cream-2:#E6E4D9;--stone:#D6D4C8;--text-mute:#8C8A84;--text-muted-2:#5C5C5C;
    --ink:#191919;--accent:{{accent_hex}};
    --font-sans:'Inter',sans-serif;--font-serif:'Newsreader',serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:var(--font-sans);background:var(--void);color:var(--cream);
    -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;font-weight:300}
  body::selection{background:rgba(217,119,87,.32)}
  h1,h2,h3,h4{font-family:var(--font-serif);letter-spacing:0}
  p{color:var(--cream-2);line-height:1.72}
  a{color:var(--cyan);text-decoration:none;font-weight:500}
  a:hover{text-decoration:underline}
  code{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono","Courier New",monospace;
    font-size:.92em;border:1px solid var(--edge);border-radius:5px;background:var(--panel2);padding:1px 5px;color:var(--cream)}
  ul{margin:10px 0 0 22px;color:var(--cream-2);line-height:1.7}
  li{margin:8px 0}

  .topbar{position:sticky;top:0;z-index:20;border-bottom:1px solid rgba(243,241,231,.08);
    background:rgba(10,6,8,.9);backdrop-filter:blur(12px)}
  .topbar-inner{max-width:1360px;margin:0 auto;padding:13px 24px;display:flex;align-items:center;justify-content:space-between;gap:18px}
  .brand-lockup{display:inline-flex;align-items:center;gap:9px;min-height:28px}
  .brand-lockup img{height:22px;width:auto;display:block}
  .brand-text{font-family:var(--font-serif);font-weight:500;text-transform:uppercase;letter-spacing:.08em;font-size:12px;color:var(--cream)}
  .source-name{color:var(--text-mute);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

  header{max-width:1360px;margin:0 auto;padding:34px 24px 20px;display:grid;grid-template-columns:minmax(0,1fr) 370px;gap:28px;align-items:center}
  .header-copy{min-width:0}
  .eyebrow{color:var(--terracotta);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
  h1{max-width:920px;margin:10px 0 18px;font-size:clamp(32px,4.6vw,58px);font-weight:500;line-height:1.02;color:var(--cream)}
  .subtitle{max-width:860px;color:var(--text-mute);font-size:16px}
  /* header visual — the SVG pinned to the top-right column of the header */
  .header-visual{margin-top:0;min-height:230px;width:100%;border:1px solid var(--edge);border-radius:8px;
    background:linear-gradient(180deg,rgba(24,24,27,.55),rgba(10,10,12,.7))}
  .header-visual text{font:600 13px Inter,sans-serif;fill:var(--cream)}
  .header-visual .muted{fill:var(--text-mute);font-weight:500;font-size:11px}
  .header-visual .box{fill:rgba(24,24,27,.85);stroke:var(--edge);stroke-width:1.2}
  .header-visual .hot{fill:rgba(217,119,87,.18);stroke:var(--terracotta)}
  .header-visual .line{stroke:var(--cyan);stroke-width:1.6;fill:none;marker-end:url(#rr-arrow)}

  .taxonomy-pills{display:flex;flex-wrap:wrap;gap:6px;margin:12px 0 0;max-width:980px}
  .pill{display:inline-flex;align-items:center;gap:5px;min-height:23px;padding:2px 8px;border:1px solid var(--edge);
    border-radius:999px;line-height:1;background:rgba(24,24,27,.55)}
  .pill-label{color:var(--text-mute);font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
  .pill-value{color:var(--cream);font-size:11px;font-weight:600}
  .pill-tenant{border-color:rgba(217,119,87,.4)}
  .pill-type{border-color:rgba(103,232,249,.35)}
  .pill-status{border-color:rgba(103,232,249,.25)}
  .pill-need{border-color:rgba(217,119,87,.45)}

  /* format-example framing banner (operator-directed): this report is
     primarily a FORMAT sample — how the standard report feels on web+mobile */
  .format-note{max-width:1360px;margin:0 auto;padding:0 24px}
  .format-note-inner{border:1px solid rgba(217,119,87,.4);border-left:3px solid var(--terracotta);
    border-radius:0 10px 10px 0;background:rgba(217,119,87,.08);padding:15px 18px}
  .format-note-inner p{font-size:13.5px;color:var(--stone)}
  .format-note-inner strong{color:var(--cream);font-weight:600}

  .layout{max-width:1360px;margin:0 auto;padding:22px 24px 56px;display:grid;grid-template-columns:300px minmax(0,1fr);gap:28px;align-items:start}
  .section-menu{position:sticky;top:64px;border:1px solid var(--edge);border-radius:8px;background:rgba(24,24,27,.62);backdrop-filter:blur(12px);padding:12px}
  .menu-title{margin:0 0 10px;color:var(--text-mute);font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
  .section-menu nav{display:grid;gap:5px}
  .section-menu nav a{width:100%;display:grid;grid-template-columns:30px 1fr;align-items:center;gap:8px;padding:8px;
    border:1px solid var(--edge);border-radius:6px;background:rgba(17,17,18,.5);color:var(--cream-2);
    font-size:12px;line-height:1.25;text-decoration:none;font-weight:400;transition:border-color .18s,background .18s}
  .section-menu nav a span{color:var(--terracotta);font-size:10px;font-weight:700;letter-spacing:.08em}
  .section-menu nav a:hover{border-color:var(--terracotta);background:rgba(24,24,27,.85);text-decoration:none}

  /* ONE continuous document: open sections, no folds */
  .sections{display:grid;gap:10px}
  section.rsec{border:1px solid var(--edge);border-radius:8px;background:rgba(17,17,18,.55);overflow:hidden}
  .rsec-head{min-height:56px;display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:12px;align-items:center;padding:13px 16px;scroll-margin-top:76px}
  .section-index{color:var(--terracotta);font-size:11px;font-weight:700;letter-spacing:.1em}
  .section-title{font-family:var(--font-serif);font-size:21px;font-weight:500;line-height:1.18;color:var(--cream)}
  .section-count{color:var(--text-mute);font-size:11px;font-weight:600;white-space:nowrap}
  .section-body{border-top:1px solid var(--edge);padding:20px 28px 26px 42px;color:var(--cream-2);font-size:15px;line-height:1.72}
  .section-body p{margin:0 0 14px}
  .section-body strong{color:var(--cream);font-weight:600}

  .fact{border-left:2px solid var(--accent);background:rgba(10,10,12,.5);border-radius:0 10px 10px 0;padding:14px 16px;margin:0 0 10px}
  .fact p{font-size:13.5px;color:var(--cream-2);margin:0}
  .fact .cite{font-size:11px;color:var(--text-mute);margin-top:6px}
  .chip{display:inline-block;font-size:9px;text-transform:uppercase;letter-spacing:.18em;padding:3px 10px;border:1px solid var(--edge);border-radius:2px;color:var(--text-mute);margin-bottom:8px}
  .chip.verified{border-color:rgba(103,232,249,.5);color:var(--cyan)}
  .chip.inferred{border-color:rgba(217,119,87,.5);color:var(--terracotta)}
  .chip.needs_call{color:var(--text-mute)}

  /* metadata footer (tac-plan shell) */
  .metadata-footer{max-width:1360px;margin:0 auto;padding:24px;border-top:1px solid var(--edge)}
  .metadata-grid{display:flex;flex-wrap:wrap;gap:28px}
  .metadata-grid > div span{display:block;color:var(--text-mute);font-size:10px;text-transform:uppercase;letter-spacing:.12em;font-weight:700}
  .metadata-grid > div strong{font-family:var(--font-serif);font-weight:500;font-size:15px;color:var(--cream)}
  footer.fine{max-width:1360px;margin:0 auto;padding:0 24px 44px;font-size:10px;color:var(--text-muted-2);letter-spacing:.1em}
{{feedback_css}}
  /* feedback drawer tinted by the client logo accent (operator-directed) */
  .fb-tab{background:var(--accent);color:{{accent_ink}}}
  .fb-tab:hover{background:var(--accent);filter:brightness(.9)}
  #fb-submit{background:var(--accent);color:{{accent_ink}}}
  #fb-submit:hover{background:var(--accent);filter:brightness(.9)}
  @media(max-width:820px){
    header,.layout{grid-template-columns:1fr}
    .section-menu{position:static}
    .header-visual{min-height:190px}
  }
  @media print{
    body{background:none;color:var(--ink)}
    h1,.section-title,.metadata-grid > div strong{color:var(--ink)}
    .section-menu,.topbar,.feedback{display:none !important}
  }
</style>
</head>
<body id="top">
<div class="topbar"><div class="topbar-inner">
  <span class="brand-lockup">{{brandrow}}</span>
  <span class="source-name">company research report · {{generated_on}} · public sources only</span>
</div></div>

<header>
  <div class="header-copy">
    <p class="eyebrow">{{company_name}} research · format sample</p>
    <h1>{{company_name}}: what public sources say.</h1>
    <p class="subtitle">{{exec_summary}}</p>
    <div class="taxonomy-pills">
      <span class="pill pill-tenant"><span class="pill-label">client</span><span class="pill-value">{{company_name}}</span></span>
      <span class="pill pill-type"><span class="pill-label">type</span><span class="pill-value">research report</span></span>
      <span class="pill pill-status"><span class="pill-label">engine</span><span class="pill-value">{{research_engine}}</span></span>
      <span class="pill pill-status"><span class="pill-label">facts</span><span class="pill-value">{{fact_total}} cited</span></span>
      <span class="pill pill-status"><span class="pill-label">sources</span><span class="pill-value">{{source_total}}</span></span>
      <span class="pill pill-need"><span class="pill-label">status</span><span class="pill-value">draft — nothing connected</span></span>
    </div>
  </div>
  <!-- the SVG, top-right: research pipeline visual -->
  <svg class="header-visual" viewBox="0 0 370 230" role="img" aria-label="Public sources flow into cited facts, into this report, onto your phone">
    <defs>
      <marker id="rr-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" fill="#67E8F9"/>
      </marker>
    </defs>
    <rect class="box" x="18" y="22" width="150" height="40" rx="8"/>
    <text x="93" y="41" text-anchor="middle">Public sources</text>
    <text class="muted" x="93" y="55" text-anchor="middle">web · press · filings</text>
    <rect class="box" x="18" y="96" width="150" height="40" rx="8"/>
    <text x="93" y="115" text-anchor="middle">Cited facts</text>
    <text class="muted" x="93" y="129" text-anchor="middle">verified / inferred</text>
    <rect class="box hot" x="200" y="59" width="150" height="40" rx="8"/>
    <text x="275" y="78" text-anchor="middle">This report</text>
    <text class="muted" x="275" y="92" text-anchor="middle">standard format</text>
    <rect class="box" x="200" y="150" width="150" height="40" rx="8"/>
    <text x="275" y="169" text-anchor="middle">Your phone</text>
    <text class="muted" x="275" y="183" text-anchor="middle">web + mobile</text>
    <path class="line" d="M93 62 L93 94"/>
    <path class="line" d="M170 116 C 192 112, 192 92, 198 84"/>
    <path class="line" d="M275 101 L275 148"/>
  </svg>
</header>

<div class="format-note"><div class="format-note-inner">
  <p><strong>Why you're seeing this:</strong> this report is primarily an example of the standard
  format your team's reports ship in — a feel for how every report reads on the web and
  on mobile. The research below is real and every fact is cited, but judge the format first:
  skim it here, then open it on your phone.</p>
</div></div>

<div class="layout">
  <aside class="section-menu">
    <p class="menu-title">Contents</p>
    <nav>
      {{toc_items}}
    </nav>
  </aside>

  <div class="sections">
    {{report_sections}}
  </div>
</div>

<div class="metadata-footer">
  <div class="metadata-grid">
    <div><span>created</span><strong>{{generated_on}}</strong></div>
    <div><span>engine</span><strong>{{research_engine}}</strong></div>
    <div><span>facts</span><strong>{{fact_total}} cited</strong></div>
    <div><span>sources</span><strong>{{source_total}} consulted</strong></div>
    <div><span>agent</span><strong>{{company_name}} agent team (draft)</strong></div>
    <div><span>format</span><strong>standard report format · your brand</strong></div>
  </div>
</div>
<footer class="fine">Draft only — nothing connected · every fact cited above · an example of the report format built for {{company_name}}</footer>
{{feedback_widget}}
</body>
</html>
