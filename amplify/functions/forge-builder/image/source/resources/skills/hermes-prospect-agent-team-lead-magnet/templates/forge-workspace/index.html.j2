<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#F3F1E7">
  <meta name="gbauto-theme-id" content="gbauto-theme.v1">
  <meta name="gbauto-theme-version" content="2026-06-11">
  <title>{{name}} | Agent Forge</title>
  <style>{{styles}}</style>
</head>
<body class="forge" data-design="studio" data-mode="light" data-gbauto-theme="gbauto-theme.v1" data-gbauto-surface="forge-lead-magnet">
  <a class="skip-link" href="#workspace">Skip to workspace</a>
  <header class="app-header">
    <a class="brand" href="#" aria-label="Agent Forge home"><img class="brand-logo" src="{{logo}}" width="30" height="28" alt="GB Automation"><span>GB AUTOMATION</span></a>
    <span class="header-divider"></span>
    <div class="product-name">Agent Forge <span class="edition">NEXUS</span></div>
    <div class="header-end"><button id="mode-toggle" class="light-button" aria-label="Dark mode" aria-pressed="false" title="Turn on dark mode"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 13.4A8.5 8.5 0 0 1 10.6 3.5a8.5 8.5 0 1 0 9.9 9.9Z"/></svg><span class="mode-label">Dark mode</span></button><button class="light-button download-config" data-action="export-config">Download YAML</button><button id="help-button" class="icon-button" aria-label="Workspace help">?</button></div>
  </header>
  <div class="workspace-bar">
    <div class="expert-heading"><span class="expert-mark" aria-hidden="true">{{initial}}</span><div><strong>{{name}}</strong><span>Your expert design <b>/</b> Draft for review</span></div></div>
    <div class="workspace-actions">
      <div class="segmented" role="group" aria-label="Workspace view"><button id="workspace-view" aria-pressed="true">Workspace</button><button id="gallery-view" aria-pressed="false">All windows <span>{{window_count}}</span></button></div>
      <label class="layout-label"><span class="sr-only">Workspace layout</span><select id="layout-select"><option value="balanced">Balanced</option><option value="focus">Focus</option><option value="review">Review</option><option value="dashboard">Dashboard</option></select></label>
      <button id="reset-layout" class="light-button" title="Restore the balanced window arrangement">Reset layout</button>
      <button id="windows-button" class="light-button" aria-expanded="false" aria-controls="window-launcher">+ Windows</button>
    </div>
  </div>
  <section id="gallery-intro" class="gallery-intro" hidden>
    <div><span class="eyebrow">THE WINDOW COLLECTION</span><h1>Your expert, window by window.</h1><p>Explore your design, leave feedback and export the configuration. Notes stay in this browser until you export them.</p></div>
    <div class="review-summary"><strong id="review-count">0 / {{window_count}}</strong><span>windows reviewed</span><button id="export-review" class="light-button">Export review <span aria-hidden="true">↗</span></button></div>
  </section>
  <main id="workspace" tabindex="-1" aria-label="Expert window workspace"><img class="workspace-watermark" src="{{logo}}" alt="" aria-hidden="true" draggable="false"><div class="canvas-grid" aria-hidden="true"></div><div id="snap-hint" hidden></div></main>
  <nav id="dock" class="window-dock" aria-label="Open a workspace window"></nav>
  <footer class="app-status"><span><i></i> Expert design <b>·</b> Not activated</span><span id="save-status">Layout & feedback saved in this browser</span></footer>
  <aside id="window-launcher" class="launcher" aria-label="Window library" hidden><div class="launcher-heading"><div><span class="eyebrow">YOUR WORKSPACE</span><h2>Open a window</h2></div><button id="close-launcher" class="icon-button" aria-label="Close window library">×</button></div><input id="window-search" type="search" placeholder="Find a window…" aria-label="Find a window"><div id="window-list"></div></aside>
  <dialog id="help-dialog"><form method="dialog"><button class="dialog-close" aria-label="Close help">×</button></form><span class="eyebrow">MAKE YOURSELF AT HOME</span><h2>One workspace. Your arrangement.</h2><p>Drag a window by its title bar. Resize from the bottom-right corner. Drop near a workspace edge to snap, or use the window menu to position it.</p><p>Minimize windows to the dock. Double-click a title bar to maximize. Use <strong>All windows</strong> to review every component.</p><p>Keyboard: focus a title bar and use arrow keys to move; Shift + arrows to resize. Escape closes a menu or restores a maximized window.</p><div class="help-note">This is your proposed expert design. Read the brief in Working Canvas, inspect the configuration and download the YAML. Conversation holds local notes for your meeting. Export feedback to share it. Connections and activation are separate setup steps.</div><a href="https://expert-atlas--gbautoxyz.netlify.app/style-guide/library/nexus-forge-workspace.html" target="_blank" rel="noopener">View the design reference ↗</a></dialog>
  <div id="toast" role="status" aria-live="polite"></div>
  {{panels}}
  <dialog id="planning-dialog" aria-labelledby="planning-dialog-title"><form method="dialog"><button class="dialog-close" aria-label="Close document preview">×</button></form><h2 id="planning-dialog-title"></h2><p id="planning-dialog-note" class="tiny"></p><div id="planning-dialog-body"></div></dialog>
  <noscript><p>This interactive workspace requires JavaScript. The adjacent expert-config.yaml file contains the draft configuration.</p></noscript>
  <script id="forge-data" type="application/json">{{data_json}}</script>
  <script id="yaml-data" type="application/json">{{yaml_json}}</script>
  <script>{{host_bridge_script}}</script>
  <script>{{mode_script}}</script>
  <script>{{workshop_script}}</script>
  <script id="planning-data" type="application/json">{{planning_json}}</script>
  <script>{{planning_script}}</script>
  <script>{{history_script}}</script>
  <script>{{approval_script}}</script>
  {{bokeh_resources}}
  <script id="atlas-chart" type="application/json">{{atlas_chart_json}}</script>
  <script id="atlas-snapshot" type="application/json">{{atlas_snapshot_json}}</script>
  <script>{{atlas_script}}</script>
</body>
</html>
