{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "agent_id",
    "config_sha256",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "forge-artifact-manifest.v1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifacts": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "filename",
        "title",
        "mime",
        "bytes",
        "sha256",
        "kind",
        "prd_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
        },
        "filename": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,119}\\.(html|yaml|json|md|txt)$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "mime": {
          "enum": [
            "text/html",
            "application/yaml",
            "application/json",
            "text/markdown",
            "text/plain"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3000000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "example",
            "actual"
          ]
        },
        "prd_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^prd_[a-f0-9]{20}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
