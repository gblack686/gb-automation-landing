<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{company_name}} × GBAutomation — Your Drafted Hermes Agent Team</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
/* client-report theme (neon fusion) — palette manifest: templates/themes/client-report.json.
   Skin derived from the operator's Neon Oiran template; client logo + accent from
   logo-verification.json; Hermes caduceus glyph as the fixed backdrop (operator-directed). */
:root{
  --void:#0A0608; --void2:#0A0A0C; --panel:#111112; --panel2:#18181B; --edge:#1F1F22;
  --cyan:#67E8F9; --terracotta:#D97757; --terracotta-hover:#B75F43;
  --cream:#F3F1E7; --cream2:#E6E4D9; --stone:#D6D4C8; --mute:#8C8A84; --mute2:#5C5C5C;
  --accent:{{accent_hex}};
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
  .reveal{opacity:1 !important;transform:none !important;filter:none !important;transition:none !important}
  #scanline{display:none}
}
body{background:var(--void);color:var(--cream);font-family:'Inter',sans-serif;font-weight:300;line-height:1.65;overflow-x:hidden}
h1,h2,h3{font-family:'Bebas Neue',sans-serif;font-weight:400;letter-spacing:.04em;line-height:1.04}
a{color:inherit}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}
/* ambience: scanline sweep + glow orbs + Hermes caduceus backdrop */
#scanline{position:fixed;left:0;width:100%;height:120px;z-index:5;pointer-events:none;opacity:.5;
  background:linear-gradient(180deg,transparent,rgba(103,232,249,.05) 45%,rgba(103,232,249,.12) 50%,rgba(103,232,249,.05) 55%,transparent);
  animation:scan 9s linear infinite}
@keyframes scan{0%{top:-15%;opacity:0}8%{opacity:.5}92%{opacity:.5}100%{top:110%;opacity:0}}
.orb{position:fixed;border-radius:50%;filter:blur(110px);pointer-events:none;z-index:0}
.orb.a{width:460px;height:460px;background:rgba(217,119,87,.13);top:-140px;right:-120px}
.orb.b{width:420px;height:420px;background:rgba(103,232,249,.08);bottom:-160px;left:-140px}
.hermes-backdrop{position:fixed;inset:0;margin:auto;width:min(66vw,680px);height:auto;
  opacity:.09;z-index:0;pointer-events:none;filter:drop-shadow(0 0 80px rgba(103,232,249,.7))}
.gb-backdrop-overlay{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);
  width:77vw;max-width:none;height:auto;max-height:94vh;object-fit:contain;
  opacity:.05;z-index:0;pointer-events:none}
/* workflow catalog 5x5 grid */
.wf-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
@media(max-width:980px){.wf-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:620px){.wf-grid{grid-template-columns:repeat(2,1fr)}}
.wf-cell{background:var(--panel);border:1px solid var(--edge);border-radius:10px;padding:12px;
  font-size:12.5px;letter-spacing:.03em;color:var(--cream2);display:flex;flex-direction:column;
  gap:6px;min-height:74px;transition:border-color .25s ease,transform .25s ease}
.wf-cell:hover{border-color:var(--accent);transform:translateY(-2px)}
.wf-cell .wf-num{font-family:'Bebas Neue',sans-serif;font-size:12px;color:var(--mute);letter-spacing:.14em}
/* section 00 hermes intro */
.hermes-intro{display:grid;grid-template-columns:auto 1fr;gap:28px;align-items:center;margin-top:8px}
@media(max-width:700px){.hermes-intro{grid-template-columns:1fr}}
.hermes-intro-logo{height:120px;width:auto;opacity:.95;filter:drop-shadow(0 0 24px rgba(103,232,249,.35))}
.hermes-stars{margin-top:12px;font-size:13px;color:var(--cream2);letter-spacing:.04em}
.hermes-stars .stars{color:var(--terracotta);letter-spacing:.18em;margin-right:8px}
.rack-item .rack-gb{height:12px;width:auto;margin-left:8px;vertical-align:middle;opacity:.75}
/* kanban board (mirrors the transcript-mock sprint board) */
.kb-head{display:flex;align-items:center;gap:10px;margin-top:22px}
.kb-head img{height:18px;width:auto}
.kb-head span{font-size:9px;text-transform:uppercase;letter-spacing:.2em;color:var(--mute)}
.kb-board{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:14px}
@media(max-width:760px){.kb-board{grid-template-columns:repeat(2,1fr)}}
.kb-col{background:var(--panel);border:1px solid var(--edge);border-radius:10px;padding:10px;min-height:150px}
.kb-col h3{font-family:'Inter',sans-serif;font-size:9px;text-transform:uppercase;letter-spacing:.2em;color:var(--mute);padding:2px 4px 10px;display:flex;justify-content:space-between;font-weight:500}
.kb-col h3 span{color:var(--cyan)}
.kb-card{background:var(--panel2);border:1px solid var(--edge);border-radius:8px;padding:10px;margin-bottom:8px}
.kb-card p{font-size:11.5px;color:var(--cream2);line-height:1.4}
.kb-card .tag{display:inline-block;margin-top:8px;font-size:8px;text-transform:uppercase;letter-spacing:.14em;color:var(--terracotta)}
/* forged-card swap on the active carousel panel */
.roster.carousel .agent-card .art img.card-full{display:none;object-fit:contain;object-position:center;background:var(--void2);border-radius:14px}
.roster.carousel .agent-card.active .art img.card-full{display:block}
.roster.carousel .agent-card.active .art img.card-portrait{display:none}
.roster.carousel .agent-card.active:has(.card-full){background:var(--void2)}
.roster.carousel .agent-card.active:has(.card-full) .meta{display:none}
/* section 03 phone -> orchestrator -> specialists -> report -> phone flow */
.flow-figure{margin:28px 0 0;border:1px solid var(--edge);border-radius:14px;background:linear-gradient(160deg,rgba(24,24,27,.6),rgba(10,10,12,.6));padding:18px 18px 12px}
.flow-figure svg{display:block;width:100%;height:auto}
.flow-figure figcaption{font-size:9px;text-transform:uppercase;letter-spacing:.24em;color:var(--mute2);text-align:center;padding-top:10px}
.lockup .gb-mark{height:18px;width:auto;opacity:.92}
/* section 02 orchestrator + card image */
.orchestrator-row{display:grid;grid-template-columns:1.6fr 1fr;gap:20px;align-items:stretch}
@media(max-width:880px){.orchestrator-row{grid-template-columns:1fr}}
.orchestrator-row .panel.lead-card{display:flex;flex-direction:column;min-height:100%}
.orchestrator-row .panel.lead-card .open{margin-top:auto;padding-top:16px}
.lead-card-image{margin:0;text-align:center}
.lead-card-image img{width:100%;max-width:320px;border-radius:14px;box-shadow:0 0 0 1px rgba(103,232,249,.2),0 20px 50px rgba(0,0,0,.6),0 0 40px rgba(103,232,249,.12);transition:transform .25s ease}
.lead-card-image img:hover{transform:rotate(-1.5deg) scale(1.02)}
.lead-card-image figcaption{font-size:9px;color:var(--mute2);letter-spacing:.08em;margin-top:10px;text-transform:uppercase}
/* forged (agent-card-forge) card embeds */
.lead-card-forged iframe{width:100%;max-width:330px;height:444px;border:0;border-radius:14px;
  background:transparent;box-shadow:0 0 0 1px rgba(103,232,249,.2),0 20px 50px rgba(0,0,0,.6),0 0 40px rgba(103,232,249,.12)}
.cards-embed iframe{height:600px}
/* progress */
#progress{position:fixed;top:0;left:0;height:2px;width:0;background:linear-gradient(90deg,var(--terracotta),var(--cyan));z-index:60;box-shadow:0 0 12px rgba(103,232,249,.6)}
/* nav */
nav{position:sticky;top:0;z-index:50;background:rgba(10,6,8,.78);backdrop-filter:blur(14px);border-bottom:1px solid rgba(243,241,231,.08)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;padding-top:13px;padding-bottom:13px;gap:16px}
.lockup{display:flex;align-items:center;gap:12px;font-size:11px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:rgba(243,241,231,.85)}
.lockup img{height:22px;width:auto;display:block}
.lockup .x{color:var(--mute);letter-spacing:.14em}
.navlinks{display:flex;gap:18px;font-size:10px;text-transform:uppercase;letter-spacing:.22em;color:var(--mute)}
.navlinks a{text-decoration:none;transition:color .15s,text-shadow .15s}
.navlinks a:hover{color:var(--cyan);text-shadow:0 0 12px rgba(103,232,249,.8)}
@media(max-width:900px){.navlinks{display:none}}
details.mobile-nav{display:none}
@media(max-width:900px){
  details.mobile-nav{display:block;position:relative}
  details.mobile-nav summary{list-style:none;cursor:pointer;font-size:10px;text-transform:uppercase;letter-spacing:.22em;padding:7px 14px;border:1px solid var(--edge);border-radius:999px;background:rgba(24,24,27,.6);color:var(--cream)}
  details.mobile-nav > div{position:absolute;right:0;top:42px;background:var(--void2);border:1px solid var(--edge);border-radius:12px;padding:16px 20px;display:flex;flex-direction:column;gap:11px;font-size:12px;min-width:240px;box-shadow:0 16px 44px rgba(0,0,0,.7)}
  details.mobile-nav a{text-decoration:none;color:var(--cream2)}
}
/* sections */
section{padding:80px 0;border-bottom:1px solid rgba(243,241,231,.06);position:relative;z-index:1}
.eyebrow{font-size:20px;text-transform:uppercase;letter-spacing:.34em;color:var(--terracotta);margin-bottom:12px}
.eyebrow::before{content:"// "}
.sec-title{font-size:clamp(32px,4.4vw,50px);margin-bottom:14px;text-transform:uppercase}
.sec-sub{color:var(--mute);max-width:660px;margin-bottom:30px;font-size:14px}
/* hero */
#hero{padding:92px 0 76px;overflow:hidden}
/* company logo as the hero banner image (logo-first branding) */
#hero .hero-banner-logo{position:absolute;inset:0;margin:auto;width:min(78%,780px);height:auto;
  z-index:-1;opacity:.08;pointer-events:none;filter:drop-shadow(0 0 60px rgba(103,232,249,.35))}
#hero .hero-art{position:absolute;top:0;right:-6%;height:115%;width:44%;object-fit:cover;z-index:-2;
  opacity:.32;-webkit-mask-image:linear-gradient(100deg,transparent 6%,#000 60%);
  mask-image:linear-gradient(100deg,transparent 6%,#000 60%)}
#hero .hero-art-veil{position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(10,6,8,.2),rgba(10,6,8,.85) 88%,var(--void))}
#hero .brandmark{margin-bottom:28px}
#hero .brandmark img{height:40px;width:auto;display:block}
#hero h1{font-size:clamp(48px,7.4vw,96px);max-width:900px;text-transform:uppercase;
  background:linear-gradient(100deg,var(--cream) 30%,var(--terracotta) 62%,var(--cyan) 95%);
  -webkit-background-clip:text;background-clip:text;color:transparent}
#hero .thesis{font-size:16px;color:var(--stone);max-width:620px;margin:24px 0 32px}
.safety{display:inline-flex;align-items:center;gap:9px;background:rgba(24,24,27,.55);border:1px solid rgba(103,232,249,.25);border-radius:999px;padding:8px 16px;font-size:10px;text-transform:uppercase;letter-spacing:.22em;color:rgba(243,241,231,.8);margin-bottom:26px;backdrop-filter:blur(8px)}
.safety .ping{width:7px;height:7px;border-radius:50%;background:var(--cyan);box-shadow:0 0 10px var(--cyan)}
.cta-row{display:flex;gap:14px;flex-wrap:wrap}
.btn{display:inline-block;padding:14px 30px;border-radius:4px;font-size:11px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;text-decoration:none;transition:transform .15s ease,box-shadow .15s ease,background .15s ease,color .15s ease}
.btn:hover{transform:translateY(-2px)}
.btn-primary{background:var(--terracotta);color:var(--void)}
.btn-primary:hover{background:var(--terracotta-hover);box-shadow:0 0 28px rgba(217,119,87,.5)}
.btn-ghost{border:1px solid rgba(103,232,249,.35);color:var(--cyan);background:rgba(103,232,249,.05)}
.btn-ghost:hover{box-shadow:0 0 22px rgba(103,232,249,.35)}
/* cards */
.grid{display:grid;gap:18px}
.grid.cols-2{grid-template-columns:repeat(2,1fr)}
.grid.cols-3{grid-template-columns:repeat(3,1fr)}
@media(max-width:880px){.grid.cols-2,.grid.cols-3{grid-template-columns:1fr}}
.panel{background:linear-gradient(160deg,var(--panel2),var(--panel));border:1px solid var(--edge);border-radius:12px;padding:24px;position:relative;overflow:hidden}
.panel::before{content:"";position:absolute;inset:0 0 auto 0;height:1px;background:linear-gradient(90deg,transparent,rgba(103,232,249,.4),transparent)}
.panel h3{font-size:21px;margin-bottom:8px;text-transform:uppercase;color:var(--cream)}
.panel p{font-size:13px;color:var(--mute)}
.panel .code{font-size:9px;color:var(--mute2);letter-spacing:.08em;display:block;margin-top:8px;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono","Courier New",monospace}
.tier{font-size:9px;text-transform:uppercase;letter-spacing:.26em;color:var(--terracotta)}
.cite{font-size:11px;color:var(--mute2);margin-top:10px}
.lead-card{border-left:2px solid var(--terracotta)}
.lead-card .open{font-size:9px;text-transform:uppercase;letter-spacing:.26em;color:var(--cyan);display:inline-block;margin-top:12px;text-decoration:none}
.lead-card .open::after{content:" →"}
/* collapsible folds, neon chrome */
details.fold{border:1px solid var(--edge);border-radius:12px;background:linear-gradient(160deg,rgba(24,24,27,.7),rgba(17,17,18,.7));margin-top:14px}
details.fold summary{list-style:none;cursor:pointer;padding:16px 22px;font-size:11px;text-transform:uppercase;letter-spacing:.22em;color:var(--mute);display:flex;justify-content:space-between;align-items:center}
details.fold summary::after{content:"+";font-size:16px;color:var(--cyan)}
details.fold[open] summary::after{content:"–"}
details.fold > .fold-body{padding:4px 22px 24px}
/* roster — MTG art cards; expands into the Neon Oiran panel carousel on desktop */
.roster{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:18px}
.agent-card .vlabel{display:none}
.carousel-dots{display:none}
@media(min-width:881px){
  .roster.carousel{display:flex;gap:12px;height:560px}
  .roster.carousel .agent-card{flex:1 1 0;min-width:0;position:relative;transition:flex .85s cubic-bezier(.22,1,.36,1)}
  .roster.carousel .agent-card .art{position:absolute;inset:0;aspect-ratio:auto}
  .roster.carousel .agent-card .art img,.roster.carousel .agent-card .art svg{width:100%;height:100%;object-fit:cover}
  .roster.carousel .agent-card .meta{position:absolute;left:0;right:0;bottom:0;margin:0;padding:24px;opacity:0;transform:translateY(14px);transition:opacity .5s .25s ease,transform .5s .25s ease}
  .roster.carousel .agent-card.active{flex:4.2 1 0;border-color:rgba(103,232,249,.5);box-shadow:0 0 0 1px rgba(103,232,249,.25),0 18px 48px rgba(0,0,0,.6)}
  /* forged card goes FULL PANE: pane width = card ratio × the 560px row, as a
     PIXEL flex-basis so the .85s flex transition still interpolates (flex:0 0
     auto + aspect-ratio snapped — operator flagged the lost smoothness) */
  .roster.carousel .agent-card.active:has(.card-full){flex:0 0 calc(560px * 552 / 772)}
  .roster.carousel .agent-card.active .art img.card-full{object-fit:cover;border-radius:0;background:transparent}
  .roster.carousel .agent-card.active .meta{opacity:1;transform:none}
  .roster.carousel .agent-card .vlabel{display:block;position:absolute;left:50%;bottom:22px;transform:translateX(-50%);writing-mode:vertical-rl;font-family:'Bebas Neue',sans-serif;font-size:19px;letter-spacing:.14em;text-transform:uppercase;color:rgba(243,241,231,.85);white-space:nowrap;transition:opacity .3s;text-shadow:0 2px 12px rgba(0,0,0,.9);z-index:2}
  .roster.carousel .agent-card.active .vlabel{opacity:0}
  .roster.carousel .agent-card:hover{transform:none}
  .carousel-dots{display:flex;gap:8px;align-items:center;margin-top:18px;background:rgba(24,24,27,.55);border:1px solid var(--edge);border-radius:999px;padding:10px 14px;width:max-content;backdrop-filter:blur(8px)}
  .carousel-dots button{height:4px;width:26px;border:0;border-radius:2px;background:rgba(243,241,231,.2);cursor:pointer;transition:width .3s,background .3s,box-shadow .3s;padding:0}
  .carousel-dots button.active{width:52px;background:var(--cyan);box-shadow:0 0 10px rgba(103,232,249,.8)}
}
.agent-card{display:block;text-decoration:none;background:var(--panel);border:1px solid var(--edge);border-radius:12px;overflow:hidden;position:relative;transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}
.agent-card:hover{transform:translateY(-5px);border-color:rgba(103,232,249,.5);box-shadow:0 0 0 1px rgba(103,232,249,.25),0 18px 48px rgba(0,0,0,.6),0 0 34px rgba(103,232,249,.12)}
.agent-card .art{aspect-ratio:4/3;background:var(--void2);position:relative;overflow:hidden}
.agent-card .art img,.agent-card .art svg{display:block;width:100%;height:100%;object-fit:cover;transition:transform .35s ease}
.agent-card:hover .art img{transform:scale(1.06)}
.agent-card .art::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,rgba(10,6,8,.92))}
.agent-card .meta{position:relative;padding:16px 18px 18px;margin-top:-44px}
.agent-card .meta h3{font-size:21px;text-transform:uppercase;color:var(--cream);margin:4px 0 6px}
.agent-card .meta p{font-size:12px;color:var(--mute);min-height:36px}
.agent-card .open{font-size:9px;text-transform:uppercase;letter-spacing:.26em;color:var(--cyan);margin-top:10px;display:inline-block}
.agent-card .open::after{content:" →"}
.art-credit{font-size:9px;color:var(--mute2);letter-spacing:.06em;margin-top:8px;display:block}
.rack-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:10px;margin-top:12px}
.rack-item{border:1px solid var(--edge);border-radius:8px;padding:13px 15px;background:rgba(10,10,12,.5)}
.rack-item strong{display:block;font-size:13px;color:var(--cyan);font-weight:500;letter-spacing:.04em}
.rack-item span{font-size:11px;color:var(--mute)}
/* embedded report preview (live iframe of the generated research report) */
.report-embed{border:1px solid var(--edge);border-radius:12px;overflow:hidden;margin-top:20px;background:var(--void2);box-shadow:0 0 0 1px rgba(103,232,249,.08),0 18px 48px rgba(0,0,0,.5)}
.report-embed iframe{width:100%;height:540px;border:0;display:block}
.report-embed .embed-bar{display:flex;justify-content:space-between;align-items:center;padding:10px 16px;border-bottom:1px solid var(--edge);font-size:9px;text-transform:uppercase;letter-spacing:.24em;color:var(--mute)}
.report-embed .embed-bar span:last-child{color:var(--cyan)}
figure.viz{border:1px solid var(--edge);border-radius:12px;overflow:hidden;background:var(--panel);margin-top:18px}
figure.viz svg{display:block;width:100%;height:auto;opacity:.92}
figcaption{font-size:10px;color:var(--mute2);padding:10px 16px;border-top:1px solid var(--edge);text-transform:uppercase;letter-spacing:.14em}
.reveal{opacity:0;transform:translateY(18px);filter:blur(6px);transition:opacity .6s ease,transform .6s ease,filter .6s ease}
.reveal.active{opacity:1;transform:none;filter:none}
footer{padding:48px 0;font-size:11px;color:var(--mute2);text-align:center;letter-spacing:.08em;position:relative;z-index:1}
/* print / PDF brief */
@media print{
  nav,#progress,#scanline,.orb,.hermes-backdrop,.cta-row,.btn,details.mobile-nav{display:none !important}
  body{background:none;color:var(--void)}
  section{padding:22px 0;border-bottom:1px solid var(--stone);break-inside:avoid}
  .reveal{opacity:1;transform:none;filter:none}
  .panel,.agent-card,details.fold,.rack-item{background:none;border:1px solid var(--stone)}
  .panel h3,.agent-card .meta h3,#hero h1,.rack-item strong{color:var(--void);-webkit-text-fill-color:initial;background:none}
  .panel p,.agent-card .meta p,#hero .thesis,.rack-item span{color:var(--mute2)}
  details.fold:not([open]) > .fold-body{display:block}
  .lockup img,#hero .brandmark img{filter:none}
}
</style>
</head>
<body>
<div id="progress" aria-hidden="true"></div>
<div id="scanline" aria-hidden="true"></div>
<div class="orb a" aria-hidden="true"></div>
<div class="orb b" aria-hidden="true"></div>
{{hermes_backdrop}}
<nav aria-label="Report navigation">
  <div class="wrap">
    <span class="lockup">{{lockup_html}}</span>
    <div class="navlinks">
      <a href="#hermes">Hermes</a><a href="#reports">Reports</a><a href="#transcript-sprint">Action Items</a><a href="#architecture">Architecture</a><a href="#specialists">Specialists</a><a href="#workflows">Workflows</a><a href="#prd-system">PRD System</a><a href="#kanban">Board</a><a href="#cta">Engage</a>
    </div>
    <details class="mobile-nav">
      <summary>Contents</summary>
      <div>
        <a href="#hermes">What is Hermes</a><a href="#reports">Reports on demand</a><a href="#transcript-sprint">Notes → action items</a><a href="#architecture">The architecture</a><a href="#orchestrator">Meet your orchestrator</a><a href="#specialists">Meet your specialists</a><a href="#workflows">Workflow presets</a><a href="#prd-system">Philosophy &amp; the PRD system</a><a href="#kanban">The board</a><a href="#cta">Next step</a><a href="#brief">Save the brief</a>
      </div>
    </details>
  </div>
</nav>

<main>
<section id="hero">
  {{hero_art}}
  <div class="wrap">
    <div class="brandmark">{{hero_brandmark}}</div>
    <div class="safety"><span class="ping"></span>{{safety_line}}</div>
    <h1>A Hermes agent team, drafted for {{company_name}}.</h1>
    <p class="thesis">{{thesis}}</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="#specialists">Meet the team</a>
