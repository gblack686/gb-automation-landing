<script>
(function(){
  "use strict";
  var bar = document.getElementById("progress");
  function onScroll(){
    var h = document.documentElement;
    var max = h.scrollHeight - h.clientHeight;
    bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + "%";
  }
  window.addEventListener("scroll", onScroll, {passive:true});
  onScroll();
  var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var reveals = document.querySelectorAll(".reveal");
  if (reduced || !("IntersectionObserver" in window)) {
    reveals.forEach(function(el){ el.classList.add("active"); });
  } else {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (entry.isIntersecting) { entry.target.classList.add("active"); io.unobserve(entry.target); }
      });
    }, {threshold: 0.12});
    reveals.forEach(function(el){ io.observe(el); });
  }

  // Expanding-panel roster carousel (Neon Oiran pattern, vanilla JS).
  // Inactive panel click = expand; active panel click = follow the profile link.
  var carousel = document.getElementById("op-carousel");
  var dotsWrap = document.getElementById("op-dots");
  var wide = window.matchMedia("(min-width: 881px)").matches;
  if (carousel && dotsWrap && wide && !reduced) {
    var panels = Array.prototype.slice.call(carousel.querySelectorAll(".agent-card"));
    if (panels.length > 1) {
      var current = 0;
      var timer = null;
      panels.forEach(function(_, i){
        var dot = document.createElement("button");
        dot.type = "button";
        dot.setAttribute("aria-label", "Operative " + (i + 1));
        dot.addEventListener("click", function(){ setActive(i); stopAuto(); });
        dotsWrap.appendChild(dot);
      });
      var dots = Array.prototype.slice.call(dotsWrap.children);
      function setActive(index){
        current = index;
        panels.forEach(function(p, i){ p.classList.toggle("active", i === index); });
        dots.forEach(function(d, i){ d.classList.toggle("active", i === index); });
      }
      function stopAuto(){ if (timer) { clearInterval(timer); timer = null; } }
      panels.forEach(function(panel, i){
        panel.addEventListener("click", function(evt){
          if (!panel.classList.contains("active")) {
            evt.preventDefault();
            setActive(i);
            stopAuto();
          }
        });
      });
      setActive(0);
      timer = setInterval(function(){ setActive((current + 1) % panels.length); }, 4500);
    }
  }
})();
</script>
</body>
</html>
